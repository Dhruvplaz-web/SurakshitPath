# ==============================================================================
# SurakshitPath - Environment Configuration Template
# Transparent Safe-Route Planning for Night Travel (Pune Testbed)
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=production

# Base URL for API & Reverse Proxy (leave blank if serving client-only routing engine)
VITE_API_BASE_URL=https://api.surakshitpath.org

# Pune Municipal Corporation (PMC) & PCMC Smart City Integration Endpoint (Optional)
VITE_PMC_IOT_FEED_URL=https://smartcity.punecorporation.org/api/v1/telemetry

# Map & Geocoding Rate Limits (Nominatim & Overpass QL)
VITE_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
VITE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Public Domain & Canonical URL (for SEO OpenGraph & Twitter Cards)
VITE_SITE_URL=https://surakshitpath.org
